# OpenAI is the mandatory DMS language-model provider.
# Store the real key only in server-side environment variables or Frappe site config.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=75
OPENAI_MAX_OUTPUT_TOKENS=1400
OPENAI_KNOWLEDGE_MAX_OUTPUT_TOKENS=900
OPENAI_MAX_RETRIES=2
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Role-aware handoff to the hosted Cadence voice dashboard.
CADENCE_DASHBOARD_URL=https://your-cadence-service.up.railway.app
CADENCE_SSO_SECRET=
CADENCE_SSO_TTL_SECONDS=120
